{
  "name": "frontend",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "pnpm vendor:build && vite dev",
    "vendor:build": "vite build --config vendor/vite.vendor.config.ts",
    "version:auto": "node scripts/version-sync.mjs",
    "prebuild": "node scripts/version-sync.mjs && pnpm extract-docs",
    "build": "pnpm vendor:build && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:unit:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "node scripts/axe-audit.mjs",
    "test:a11y:ci": "node scripts/axe-audit.mjs --base-url $PLAYWRIGHT_BASE_URL",
    "extract-docs": "node scripts/extract-component-docs.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@iconify-json/bi": "1.2.7",
    "@iconify-json/lucide": "1.2.146",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.59.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/kit": "2.69.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@tsconfig/svelte": "5.0.8",
    "@types/json-bigint": "1.0.4",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "axe-core": "4.14.0",
    "bits-ui": "2.19.5",
    "clsx": "2.1.1",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "25.0.1",
    "paneforge": "1.0.2",
    "pg": "8.23.1",
    "postcss": "8.5.31",
    "runed": "0.37.1",
    "sveld": "0.36.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "svelte-toolbelt": "0.10.6",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "unplugin-icons": "23.0.1",
    "vite": "8.3.4",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint-community/regexpp": "4.12.2",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@microsoft/fetch-event-source": "2.0.1",
    "@primebrick/ui": "workspace:*",
    "class-variance-authority": "0.7.1",
    "codemirror": "6.0.2",
    "countries-list": "3.4.1",
    "dompurify": "3.4.17",
    "flag-icons": "7.6.0",
    "formsnap": "2.0.1",
    "html2pdf.js": "0.14.0",
    "inline-css": "4.0.3",
    "json-bigint": "1.0.0",
    "libphonenumber-js": "1.13.15",
    "marked": "18.1.1",
    "mermaid": "12.1.0",
    "shiki": "4.5.0",
    "svelte-motion": "0.12.2",
    "svelte-sonner": "1.2.1",
    "sveltekit-superforms": "2.30.2",
    "vscode-json-languageservice": "5.7.2",
    "vscode-languageserver-textdocument": "1.0.15",
    "zod": "4.6.7"
  }
}
